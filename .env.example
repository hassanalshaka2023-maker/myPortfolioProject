# ─── Site ────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Database (Supabase Postgres) ───────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session pooler / direct connection (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Storage (Supabase Storage) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Server-only. Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=""
# Public bucket name (created automatically by the seed script if missing)
SUPABASE_STORAGE_BUCKET="portfolio"

# ─── Auth (Auth.js) ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"

# ─── Email notifications (Resend) ───────────────────────────────────
# Optional: if empty, contact messages are still saved to the DB
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=""
